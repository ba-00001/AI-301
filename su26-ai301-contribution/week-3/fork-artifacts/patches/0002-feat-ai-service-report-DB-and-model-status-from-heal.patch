From cb1d8de9b5769cbd3806e0c927b5a5a8ee64ef99 Mon Sep 17 00:00:00 2001
From: BRIANB <124537281+ba-00001@users.noreply.github.com>
Date: Mon, 8 Jun 2026 10:30:00 -0400
Subject: [PATCH 2/3] feat(ai-service): report DB and model status from /health

Replace the static {"status":"ok"} stub with a payload reporting database
connectivity (via check_connection) and model/MCP status (MCP server name,
embedding dimensions, embedding provider). Return 200 when the database is
reachable and 503 when it is not so monitoring can act on the status code.

Closes #39

Signed-off-by: BRIANB <124537281+ba-00001@users.noreply.github.com>
---
 apps/ai-service/src/main.py | 29 ++++++++++++++++++++++++++---
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/apps/ai-service/src/main.py b/apps/ai-service/src/main.py
index c9e88d7..2655b8d 100644
--- a/apps/ai-service/src/main.py
+++ b/apps/ai-service/src/main.py
@@ -5,7 +5,9 @@ from time import perf_counter
 
 from fastapi import FastAPI, Request
 from fastapi.middleware.cors import CORSMiddleware
-from .db import connect_db, close_db
+from fastapi.responses import JSONResponse
+from .config import settings
+from .db import connect_db, close_db, check_connection
 from .rag import router as rag_router
 from .mcp_server import mcp
 
@@ -67,5 +69,26 @@ app.mount("/mcp", mcp.sse_app())
 
 
 @app.get("/health")
-async def health_check() -> dict[str, str]:
-    return {"status": "ok"}
+async def health_check() -> JSONResponse:
+    """Report service health: MongoDB connectivity and model/MCP status.
+
+    Returns 200 when the database is reachable and 503 when it is not, so
+    monitoring can act on the status code as well as the JSON body.
+    """
+    database = await check_connection()
+
+    models = {
+        "mcp_server": settings.MCP_SERVER_NAME,
+        "embedding_dimensions": settings.EMBEDDING_DIMENSIONS,
+        # The embedding pipeline is still a placeholder vector (see rag.py);
+        # surfaced here so operators can see it is not a real provider yet.
+        "embedding_provider": "placeholder",
+    }
+
+    healthy = bool(database["connected"])
+    payload = {
+        "status": "ok" if healthy else "degraded",
+        "database": database,
+        "models": models,
+    }
+    return JSONResponse(status_code=200 if healthy else 503, content=payload)
